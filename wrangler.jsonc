{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbhrcom",
  "compatibility_date": "2026-07-24",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
